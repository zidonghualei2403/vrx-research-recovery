<?xml version="1.0"?>
<sdf version="1.9">
  <world name="csd_harbor">
    <physics name="4ms" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>GNN-GRU Mixed-Obstacle Harbor</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.55 0.55</ambient_light>
        <background_color>0.78 0.84 0.90</background_color>
        <camera_pose>0 -125 105 0 0.72 1.57</camera_pose>
        <camera_clip><near>0.25</near><far>2000</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="MarkerManager" name="Marker manager"/>
      <plugin filename="SelectEntities" name="Select Entities"/>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu"/>
      <plugin filename="WorldControl" name="World control">
        <gz-gui><title>World control</title>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
        </gz-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>true</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui><property type="string" key="state">floating</property></gz-gui>
        <sim_time>true</sim_time><real_time_factor>true</real_time_factor>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui><property type="string" key="state">docked_collapsed</property></gz-gui>
      </plugin>
    </gui>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <scene><sky/><grid>false</grid><ambient>1 1 1</ambient></scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-33.724223</latitude_deg>
      <longitude_deg>150.679736</longitude_deg>
      <elevation>0</elevation><heading_deg>0</heading_deg>
    </spherical_coordinates>
    <light type="directional" name="sun">
      <pose>0 0 20 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include><name>csd_ocean</name><uri>coast_waves</uri></include>

    <model name="harbor_wall_1">
      <static>true</static><pose>-11 13 1.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>14 6 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14 6 3</size></box></geometry>
          <material><ambient>0.16 0.18 0.20 1</ambient><diffuse>0.22 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="harbor_wall_2">
      <static>true</static><pose>12 -13 1.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>14 6 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14 6 3</size></box></geometry>
          <material><ambient>0.16 0.18 0.20 1</ambient><diffuse>0.22 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <plugin filename="libPublisherPlugin.so" name="vrx::PublisherPlugin">
      <message type="gz.msgs.Param" topic="/vrx/wavefield/parameters" every="2.0">
        params { key: "direction" value { type: DOUBLE double_value: 0.0 } }
        params { key: "gain" value { type: DOUBLE double_value: 0.15 } }
        params { key: "period" value { type: DOUBLE double_value: 5.0 } }
        params { key: "steepness" value { type: DOUBLE double_value: 0.0 } }
      </message>
    </plugin>

    <plugin filename="libUSVWind.so" name="vrx::USVWind">
      <wind_obj><name>wamv_1</name><link_name>wamv_1/base_link</link_name><coeff_vector>0.5 0.5 0.33</coeff_vector></wind_obj>
      <wind_obj><name>wamv_2</name><link_name>wamv_2/base_link</link_name><coeff_vector>0.5 0.5 0.33</coeff_vector></wind_obj>
      <wind_obj><name>wamv_3</name><link_name>wamv_3/base_link</link_name><coeff_vector>0.5 0.5 0.33</coeff_vector></wind_obj>
      <wind_obj><name>wamv_4</name><link_name>wamv_4/base_link</link_name><coeff_vector>0.5 0.5 0.33</coeff_vector></wind_obj>
      <wind_obj><name>wamv_5</name><link_name>wamv_5/base_link</link_name><coeff_vector>0.5 0.5 0.33</coeff_vector></wind_obj>
      <wind_obj><name>wamv_6</name><link_name>wamv_6/base_link</link_name><coeff_vector>0.5 0.5 0.33</coeff_vector></wind_obj>
      <wind_direction>240.0</wind_direction>
      <wind_mean_velocity>0.0</wind_mean_velocity>
      <var_wind_gain_constants>0.0</var_wind_gain_constants>
      <var_wind_time_constants>2.0</var_wind_time_constants>
      <random_seed>20260928</random_seed>
      <update_rate>10.0</update_rate>
      <topic_wind_speed>/vrx/debug/wind/speed</topic_wind_speed>
      <topic_wind_direction>/vrx/debug/wind/direction</topic_wind_direction>
    </plugin>

    <plugin filename="libCsdOceanCurrent.so" name="vrx_csd_shadow::CsdOceanCurrent">
      <current_velocity>0.0 0.0 0.0</current_velocity>
      <xU>100.0</xU><xUU>150.0</xUU>
      <yV>100.0</yV><yVV>100.0</yVV>
      <current_obj><link_name>wamv_1/base_link</link_name></current_obj>
      <current_obj><link_name>wamv_2/base_link</link_name></current_obj>
      <current_obj><link_name>wamv_3/base_link</link_name></current_obj>
      <current_obj><link_name>wamv_4/base_link</link_name></current_obj>
      <current_obj><link_name>wamv_5/base_link</link_name></current_obj>
      <current_obj><link_name>wamv_6/base_link</link_name></current_obj>
    </plugin>
  </world>
</sdf>
